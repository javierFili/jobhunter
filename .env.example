# JobHunter AI — variables de entorno (copiar a .env y completar; .env está en .gitignore).
# Ninguna clave de integración es obligatoria para arrancar: también se pueden cargar desde
# Integraciones (se guardan cifradas con JOBHUNTER_MASTER_KEY).

# Base de datos (ver scripts/db-setup.sql)
JOBHUNTER_DB_URL='jdbc:mysql://localhost:3306/jobhunter?serverTimezone=UTC&useUnicode=true&characterEncoding=utf8'
JOBHUNTER_DB_USER=jobhunter
JOBHUNTER_DB_PASSWORD='JhDev#2026pw'

# Seguridad (OBLIGATORIAS)
JOBHUNTER_JWT_SECRET=          # openssl rand -base64 48
JOBHUNTER_MASTER_KEY=          # openssl rand -base64 32  (cifra las credenciales guardadas en la BD)
JOBHUNTER_CORS_ORIGINS=http://localhost:5175
JOBHUNTER_COOKIE_SECURE=false  # true en producción (HTTPS)

# Archivos (CV subidos y PDFs generados)
JOBHUNTER_FILES_DIR=

# Integraciones (opcionales; si se definen aquí, el panel las muestra como "definida por variable de entorno").
# El interruptor activar/desactivar siempre está en el panel: definir una clave NO activa la integración.
JOBHUNTER_DEEPSEEK_API_KEY=
JOBHUNTER_ANTHROPIC_API_KEY=
JOBHUNTER_APIFY_TOKEN=
JOBHUNTER_SERPAPI_KEY=
JOBHUNTER_ADZUNA_APP_ID=
JOBHUNTER_ADZUNA_APP_KEY=
JOBHUNTER_HIMALAYAS_API_KEY=

# Documentación OpenAPI/Swagger en /api/docs (solo desarrollo)
JOBHUNTER_API_DOCS=true
